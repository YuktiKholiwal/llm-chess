# Vercel AI Gateway -- one key for every model in config/models.yaml,
# including the extractor. https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# To use OpenRouter instead, point provider.base_url at
# https://openrouter.ai/api/v1 and set provider.api_key_env to this name.
# OPENROUTER_API_KEY=
