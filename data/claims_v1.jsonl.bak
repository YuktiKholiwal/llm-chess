{"task_id": "0WCvK", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 0, "text": "White's queen on d7 is attacking the knight on c6", "type": "state", "subject": "c6", "structured": {"kind": "attacked", "square": "c6", "by": "white"}, "cost_usd": 0.004349}
