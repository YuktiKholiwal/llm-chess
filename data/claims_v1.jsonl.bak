{"task_id": "7ZcOe", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 1, "text": "If Kd3 or Kc2, Black plays Rxe1 winning the rook", "type": "threat", "subject": "e1", "structured": null}
