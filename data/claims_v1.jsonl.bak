{"task_id": "OOK41", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 2, "text": "Kf5 is controlled by the g4 pawn", "type": "state", "subject": "f5", "structured": {"kind": "controls_square", "square": "f5", "by": "white"}}
{"task_id": "OOK41", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 3, "text": "Kf6 is blocked by Black's own pawn on f6", "type": "state", "subject": "f6", "structured": null}
{"task_id": "OOK41", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 4, "text": "Kh6 is forced after Rg7+", "type": "threat", "subject": "", "structured": null}
{"task_id": "OOK41", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 5, "text": "Nf5+ gives another check", "type": "threat", "subject": "f5", "structured": {"kind": "check", "by": "white"}}
{"task_id": "OOK41", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 6, "text": "the knight on f5 attacks h6", "type": "state", "subject": "h6", "structured": {"kind": "attacked", "square": "h6", "by": "white"}}
{"task_id": "OOK41", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 7, "text": "g6 is covered by the rook on g7", "type": "state", "subject": "g6", "structured": {"kind": "controls_square", "square": "g6", "by": "white"}}
{"task_id": "OOK41", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 8, "text": "the f6 pawn can capture on g5", "type": "threat", "subject": "", "structured": null}
{"task_id": "OOK41", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 9, "text": "After Nf5+ the king goes to Kh7, we can play Rg6 threatening Rh6#", "type": "plan", "subject": "", "structured": null}
{"task_id": "OOK41", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 10, "text": "the knight on f5 covers h4", "type": "state", "subject": "h4", "structured": {"kind": "controls_square", "square": "h4", "by": "white"}}
