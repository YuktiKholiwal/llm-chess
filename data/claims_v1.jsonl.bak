{"task_id": "ftH08", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 1, "text": "After Nxf2, if Kxf2, then Qxe1+ wins the rook on e1", "type": "threat", "subject": "", "structured": null}
{"task_id": "ftH08", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 2, "text": "the king is exposed on f2", "type": "state", "subject": "f2", "structured": null}
{"task_id": "ftH08", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 3, "text": "If White doesn't take the knight, Black still plays Qxe1+ winning the rook", "type": "threat", "subject": "", "structured": null}
{"task_id": "ftH08", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 4, "text": "If Qxe4, then Qxe1+ Kh1, and Black is up a full rook for a knight", "type": "threat", "subject": "", "structured": null}
