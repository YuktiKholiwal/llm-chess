{"task_id": "KVJa1", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 0, "text": "The white queen on c2 is giving check along the diagonal c2-d3-e4-f5-g6-h7 to the black king on h7", "type": "state", "subject": "h7", "structured": {"kind": "check", "by": "white"}, "cost_usd": 0.003614}
{"task_id": "KVJa1", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 1, "text": "g5f5 or g5g6 blocks the check but White captures the queen (Qxf5 or Qxg6+), losing material badly", "type": "threat", "subject": "", "structured": null}
{"task_id": "KVJa1", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 2, "text": "King moves (h7g8, h7h6, h7h8): King escapes but White can play Qxd2, eliminating the dangerous passed pawn", "type": "threat", "subject": "", "structured": null}
