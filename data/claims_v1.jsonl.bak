{"task_id": "SWB4M", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 3, "text": "after Bf6, if Black plays Kg8, then h6, and h7+ Kh8 Bg7# is unavoidable", "type": "threat", "subject": "", "structured": null}
