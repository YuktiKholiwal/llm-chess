{"task_id": "weioO", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 7, "text": "Qxg2 is checkmate since the king on h1 has no escape squares", "type": "threat", "subject": "g2", "structured": {"kind": "mate_in", "count": 1, "by": "black"}}
{"task_id": "weioO", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 8, "text": "After Rc1+, Bd1 is possible", "type": "threat", "subject": "d1", "structured": null}
