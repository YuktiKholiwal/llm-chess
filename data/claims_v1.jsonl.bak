{"task_id": "FZXrh", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 7, "text": "After Qe4+ Kc3 Qd3+ Kb4, Qc4# is checkmate", "type": "threat", "subject": "", "structured": {"kind": "mate_in", "count": 1, "by": "black"}}
{"task_id": "FZXrh", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 8, "text": "King on c3 can go to b4, b2", "type": "state", "subject": "", "structured": null}
