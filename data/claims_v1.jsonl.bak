{"task_id": "yZB13", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 0, "text": "White has a queen on h6 and knight on g5 aggressively placed near Black's king on g8", "type": "state", "subject": "", "structured": null, "cost_usd": 0.003099}
{"task_id": "yZB13", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 1, "text": "Qh8+ is the key move", "type": "plan", "subject": "h8", "structured": null}
