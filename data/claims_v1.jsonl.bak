{"task_id": "yZB13", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 3, "text": "Nxf7+ forks the king on h8 and the queen on c7", "type": "threat", "subject": "f7", "structured": null}
{"task_id": "yZB13", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 4, "text": "The knight on g5 reaches f7 with check", "type": "threat", "subject": "f7", "structured": {"kind": "check", "by": "white"}}
{"task_id": "yZB13", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 5, "text": "After the king moves, White captures the queen on c7 with Nxc7", "type": "plan", "subject": "c7", "structured": null}
{"task_id": "yZB13", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 6, "text": "This wins a queen for a queen plus the f7 pawn, giving White a material advantage", "type": "unverifiable", "subject": "", "structured": null}
