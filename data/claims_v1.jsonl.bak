{"task_id": "CHmXJ", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 13, "text": "After Kb5 Kc7, White can return with Kc4, keeping the position locked", "type": "plan", "subject": "", "structured": null}
{"task_id": "weioO", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 0, "text": "Black has a powerful tactical sequence starting with Rc1+", "type": "unverifiable", "subject": "", "structured": null, "cost_usd": 0.00448}
