{"task_id": "chf4l", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 8, "text": "after fxe6, Qxg7+ Qxg7 Bxg7 Kxg7 is just an equal trade", "type": "unverifiable", "subject": "", "structured": null}
