{"task_id": "v8JXi", "model": "qwen/qwen3.8-2.4t-a95b", "claim_id": 5, "text": "Qxg3+ Kh1 Qh2# is checkmate", "type": "threat", "subject": "", "structured": {"kind": "mate_in", "count": 2, "by": "black"}}
